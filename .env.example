# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://cleo:cleo@localhost:5433/cleopatra
PGPOOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000
DB_LOG=0

# ── Redis (cache · rate limit · socket adapter) ────────────────────────
REDIS_URL=redis://localhost:6380

# Guards console-facing endpoints until staff auth ships. Generate with:
#   openssl rand -hex 24
INTERNAL_API_TOKEN=

# Hosts allowed to reach /admin and the CRM API. Loopback is always
# allowed. Leave empty when exposing the app through a tunnel so the
# console stays private while the booking flow is public.
ADMIN_ALLOWED_HOSTS=

# ── Auth ─────────────────────────────────────────────────────────────────
AUTH_SECRET=change-me-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# ── Realtime gateway (Socket.IO) ────────────────────────────────────────
REALTIME_PORT=4001
# Leave empty in development: the client then uses the same hostname the
# console is on, which is what makes the session cookie reach the gateway.
# Set it only when the gateway lives on a different host in production.
NEXT_PUBLIC_REALTIME_URL=
NEXT_PUBLIC_REALTIME_PORT=4001
REALTIME_INTERNAL_TOKEN=change-me

# ── Secrets encryption (integration tokens at rest) ─────────────────────
SECRET_ENCRYPTION_KEY=change-me-32-byte-hex

# ── Outbound SMS ────────────────────────────────────────────────────────
# "log" prints messages to the console and sends nothing. Anything other
# than "twilio" is safe. Production defaults to twilio; everywhere else
# defaults to log, so a stray test cannot text a real customer.
SMS_TRANSPORT=log
WORKER_INTERVAL_MS=60000
PUBLIC_BASE_URL=http://localhost:3000
PUBLIC_BOOKING_URL=http://localhost:3000

# ── Twilio ───────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_STATUS_CALLBACK_URL=

# ── Vonage VBC ───────────────────────────────────────────────────────────
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_ACCOUNT_ID=
VONAGE_APPLICATION_ID=

# ── Cloudflare Turnstile ────────────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Background jobs ─────────────────────────────────────────────────────
# Jobs whose credentials are missing are skipped at boot, not retried.
#   sla-monitor          every 5m   (no credentials needed)
#   campaign-dispatcher  every 1m   (uses SMS_TRANSPORT)
#   rollups              every 10m  (no credentials needed)
#   winback              every 12h
#   duplicate-detector   every 6h
#   vonage-sync          every 5m   needs VONAGE_*
#   timely-sync          every 30m  needs TIMELY_*

# ── Timely (hybrid availability: read-only sync) ────────────────────────
TIMELY_API_BASE=
TIMELY_PARTNER_KEY=

# ── Uploads ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./storage/uploads
UPLOAD_PUBLIC_BASE=http://localhost:3000/storage
UPLOAD_MAX_BYTES=10485760

# ── Meta Lead Ads ───────────────────────────────────────────────────────
META_LEAD_WEBHOOK_SECRET=

# LiveChat (livechat.com) widget on the public booking pages — the studio's
# real operator queue, so loading it puts a visitor in front of a live agent.
# Leave empty on localhost. Production licence: 19440499
NEXT_PUBLIC_LIVECHAT_LICENSE=

# ── Vonage ────────────────────────────────────────────────────────────
# Signature secret from the Vonage dashboard (for webhook verification).
# Set 0 to stop the 5-minute call-log poller. Leave it off while the VBC
# credentials are wrong or the account is locked: every attempt is a failed
# login, and Vonage's lockout counts from the LAST one, so a poller on a
# timer keeps a locked account locked indefinitely.
VONAGE_SYNC_ENABLED=1
# Telephony v3 gives the calls in progress account-wide. The gateway polls
# it centrally — never per browser. Vonage publishes no rate limit for this
# endpoint, and a response takes 300-800ms, so anything under ~1.5s would
# have requests overlapping. Set 0 to turn the live board off.
VONAGE_TELEPHONY_ENABLED=1
VONAGE_POLL_MS=2000
# How long the extension -> branch -> DID map is kept before refetching.
VONAGE_DIRECTORY_TTL_MS=900000
VONAGE_SIGNATURE_SECRET=
# Traces every Vonage webhook to stdout and vonage_webhook.log while the
# numbering is being worked out. Never runs in production; set 0 to silence
# it in development. Credentials in the headers are masked either way.
VONAGE_DEBUG_LOG=1
# Vonage VBC (Vonage Business Communications) Credentials (Reports & Call Logs Sync)
VONAGE_CONSUMER_KEY=
VONAGE_CONSUMER_SECRET=
VONAGE_USERNAME=
VONAGE_PASSWORD=
# Alternative Developer API Credentials

# ── Timely ────────────────────────────────────────────────────────────
# The artists' iCalendar feeds are read only when this is "1". They are
# live studio diaries, so polling them is a deliberate act.
TIMELY_SYNC_ENABLED=
# Pause between feeds. Timely rate-limits; the old integration used 1500.
TIMELY_FEED_PACE_MS=1500

# ── SMS ───────────────────────────────────────────────────────────────
# "log" prints and sends nothing; "twilio" really sends. Unset means log
# outside production.

# ── Retention ─────────────────────────────────────────────────────────
# realtime_events is a broadcast spool, not a record; nothing reads a row
# after the socket relays it.
REALTIME_RETENTION_DAYS=7
# The carrier inbox. Unprocessed deliveries are kept regardless of age.
WEBHOOK_RETENTION_DAYS=90
# Abandoned booking-funnel reference images. Admin assets carry no session
# and are never collected, whatever this is set to.
UPLOAD_RETENTION_DAYS=7

# ── Call recordings ───────────────────────────────────────────────────
# Where audio is kept once fetched. The console plays from here rather
# than going back to the carrier every time, and a local copy is the one
# that survives the carrier's own retention. Relative paths resolve from
# the project root; the directory is created on first use.
#
# Company Call Recording is a permission on the VONAGE_USERNAME user, not
# on the account. Without it the recordings job answers
# "User is not authorized to search CCR recordings for this account" and
# halts itself — the rest of the Vonage integration keeps running.
RECORDINGS_DIR=storage/recordings
# How far back the hourly job looks for recordings to attach.
VONAGE_RECORDING_WINDOW_DAYS=7
# How far apart a recording and its call may start and still be the pair,
# for the rare entry that carries no call id. Milliseconds.
VONAGE_RECORDING_MATCH_MS=90000

# ── Webhook enforcement ───────────────────────────────────────────────
# A signature that is present and WRONG is always refused. A delivery with
# no signature at all is served but rate limited, because Vonage only
# signs the answer webhook when the application is configured to and this
# account's convention is unconfirmed — refusing outright would send every
# inbound call to "this number is not in service".
# Set to 1 once you have confirmed the account signs.
VONAGE_ANSWER_REQUIRE_SIGNATURE=0

# ── Behind a proxy ────────────────────────────────────────────────────
# The admin host check reads the Host header. Set this to 1 ONLY when
# something in front of the app overwrites x-forwarded-host itself —
# Vercel, Cloudflare, an nginx with proxy_set_header. A bare Node server
# does not, and then the header is simply a value the caller chose:
# "X-Forwarded-Host: localhost" would walk straight past ADMIN_ALLOWED_HOSTS.
TRUST_PROXY_HOST=0

# ── Realtime ──────────────────────────────────────────────────────────
# How long a revoked account can keep receiving events. The gateway
# re-resolves every open socket on this interval and disconnects the ones
# that no longer authenticate, so signing out or deactivating someone
# reaches the tab they left open. Minimum 10s.
REALTIME_REAUTH_MS=60000

# ── Calendar sync ─────────────────────────────────────────────────────
# How many artist feeds are read at once. The gap between REQUESTS stays
# at TIMELY_FEED_PACE_MS regardless, so Timely sees the same rate it
# always did; concurrency only stops one dead feed holding up the rest.
TIMELY_FEED_CONCURRENCY=4
