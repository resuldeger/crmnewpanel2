[Unit]
Description=Cleopatra realtime gateway
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=cleopatra
WorkingDirectory=/srv/cleopatra
EnvironmentFile=/srv/cleopatra/.env
ExecStart=/srv/cleopatra/node_modules/.bin/tsx scripts/realtime.ts
Restart=always
RestartSec=3
StandardOutput=append:/var/log/cleopatra/realtime.log
StandardError=append:/var/log/cleopatra/realtime.err.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
